{
  "schema": "visual-library/1",
  "revision": 1,
  "styles": [
    {
      "id": "field",
      "name": "自然观察手册",
      "summary": "把对象和特征摆在一起",
      "uses": "植物、食材、生活观察",
      "layout": "主体单独放在左侧，占 42%；右侧为标题和三条观察记录。",
      "type": "中文宋体标题，黑体标签，标题约为正文的 1.8 倍。",
      "detail": "标签用细引线；局部底板只落在文字下面。",
      "overlay": "压缩为一个主体和一行标注；引线朝留白一侧。",
      "when": "具备形态特征的主体",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "columns": "42% 1fr",
        "gapPx": 13,
        "dividerPx": 1,
        "titleFamily": "宋体"
      }
    },
    {
      "id": "manual",
      "name": "拆解说明书",
      "summary": "把动作拆成可跟做的步骤",
      "uses": "教程、维修、装配",
      "layout": "左列放短标题，右列按垂直方向排三个等宽步骤；序号沿同一轴对齐。",
      "type": "黑体标题，等宽序号；动词加粗。",
      "detail": "每步只画一个动作，连接线细于轮廓。",
      "overlay": "只保留当前步骤及其相邻步骤，其他随口播切入。",
      "when": "连续操作",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "columns": "1fr 1fr",
        "stepSeparatorPx": 1,
        "numberFamily": "monospace",
        "stepPaddingPx": 7
      }
    },
    {
      "id": "editorial",
      "name": "杂志跨页",
      "summary": "用一个大标题带出主角",
      "uses": "人物、文化、旅行",
      "layout": "顶部细横线；标题占上半部；主图与说明采用非对称双栏。",
      "type": "中文衬线展示标题，左对齐，说明用黑体。",
      "detail": "图注沿图边缘走，页内使用一条主分隔线。",
      "overlay": "保留标题、主图和一条短图注；透明区域贯穿主体周围。",
      "when": "单个物件或观点",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "columns": "1.2fr 1fr",
        "headlineSpan": 2,
        "topRulePx": 3,
        "titleFamily": "宋体"
      }
    },
    {
      "id": "measure",
      "name": "数据读数板",
      "summary": "让两组数据容易比较",
      "uses": "复盘、评测、实验",
      "layout": "一条共同基线，上方放两个等大数字；比较标签贴近各自读数。",
      "type": "等宽数字，单位缩至数值高度的 45%。",
      "detail": "变化用强调色，基准值用低彩度。",
      "overlay": "只含两个原文数值、单位和对应标签；外围透明。",
      "when": "原文中可比较的数量",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "comparisonAxis": "horizontal",
        "baselinePx": 3,
        "digitFamily": "monospace",
        "unitPx": 13
      }
    },
    {
      "id": "exhibit",
      "name": "展品铭牌",
      "summary": "让人先看展品，再读名字",
      "uses": "展览、产品、手作",
      "layout": "物件居中，四周宽留白；底部窄铭牌含名称和一句说明。",
      "type": "用中黑体标题搭配较小宋体说明，铭牌左对齐。",
      "detail": "只给铭牌边线，物件下方保留轻接触阴影。",
      "overlay": "保留物件和小铭牌，缩放时铭牌跟随物件。",
      "when": "值得辨认的物件",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "display": "centered subject over label",
        "labelWidth": "78%",
        "labelRulePx": 1,
        "titlePx": 22
      }
    },
    {
      "id": "route",
      "name": "路线导览",
      "summary": "按空间顺序介绍地点",
      "uses": "城市路线、展览、出行",
      "layout": "三个站点沿折线排列；起点靠左、终点靠右；标题在路径外。",
      "type": "黑体站名，按相同字号标注各站。",
      "detail": "终点使用实心强调点，中途使用空心圆。",
      "overlay": "只保留路线和地名，转折处避开脸和字幕。",
      "when": "有顺序的空间路径",
      "source": "grid",
      "tokens": {
        "paddingPx": 20,
        "referenceWidthPx": 480,
        "anchors": 3,
        "path": "dashed",
        "pathWidthPx": 2,
        "nodeDiameterPx": 11,
        "endNode": "filled"
      }
    }
  ],
